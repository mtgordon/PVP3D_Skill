	<LoadData>
		<load_controller id="1" name="Amp-1" type="loadcurve">
			<interpolate>SMOOTH STEP</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
		<load_controller id="2" name="TieRamp" type="loadcurve">
			<interpolate>SMOOTH STEP</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>0.1,1</pt>
			</points>
		</load_controller>
		<load_controller id="3" name="settle_on" type="loadcurve">
			<interpolate>SMOOTH STEP</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>1.0,0</pt>
				<pt>1.05,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
